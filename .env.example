# Copy to .env.local (gitignored) and fill in. These frontend values are
# publishable/non-secret and are read Vite-natively via import.meta.env.

# Convex deployment URL (from `bunx convex dev` / the Convex dashboard)
VITE_CONVEX_URL=

# Clerk publishable key (Clerk dashboard → API keys)
VITE_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# NOT a frontend variable — set in the Convex deployment environment, never
# committed, via `bunx convex env set CLERK_JWT_ISSUER_DOMAIN <value>`.
# It is the Clerk Frontend API / issuer URL from Clerk's native Convex
# integration, used by convex/auth.config.ts to verify JWTs.
#
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
